PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/BabyChat
FRONTEND_URL=http://localhost:5173
# Origin được phép gọi API/socket, phân tách bằng dấu phẩy.
# Bỏ trống → dùng FRONTEND_URL + http://localhost:5173.
# CORS_ORIGINS=https://baby-chat-rho.vercel.app

# JWT — sinh secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRES=1d
JWT_REFRESH_TOKEN_EXPIRES=7d

# Mã hoá nội dung tin nhắn khi lưu DB (AES-256-GCM). BẮT BUỘC — thiếu thì backend không khởi động.
# Dạng "<keyId>:<base64 32 byte>"; nhiều khoá phân tách bằng dấu phẩy, khoá ĐẦU dùng để mã hoá,
# các khoá sau chỉ để giải mã tin cũ (xoay khoá). Mất khoá = mất tin nhắn: cất bản sao an toàn.
# Sinh khoá: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEYS=

# File upload
STORAGE_TYPE=local # hoặc 'cloudinary'
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5

# Cloudinary (chỉ cần khi STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email xác thực đăng ký (gửi qua Brevo API)
BREVO_API_KEY=
SMTP_FROM=no-reply@example.com

# Web Push — sinh cặp key: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
